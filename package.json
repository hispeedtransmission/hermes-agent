{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "scripts": {
    "install:root": "pnpm install --frozen-lockfile",
    "install:web": "pnpm install --frozen-lockfile",
    "install:tui": "pnpm install --frozen-lockfile",
    "install:desktop": "pnpm install --frozen-lockfile",
    "audit:root": "pnpm audit",
    "audit:web": "pnpm audit",
    "audit:tui": "pnpm audit",
    "check": "pnpm -r --if-present check",
    "fix": "pnpm -r --if-present fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
